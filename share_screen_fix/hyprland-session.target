# hyprland-session.target
# ----------------------------------------------------------------------------
# Wayland/Hyprland SCREEN-SHARE FIX  (backup copy kept in DotRobot root)
#
# Problem: xdg-desktop-portal.service has `Requisite=graphical-session.target`,
# meaning it refuses to start unless that target is already active. This
# Hyprland setup (launched via /usr/bin/start-hyprland, no session manager)
# never activates graphical-session.target, so the portal never starts and
# screen sharing fails in EVERY app (no org.freedesktop.portal.ScreenCast).
#
# graphical-session.target has RefuseManualStart=yes, so it can't be started
# directly. This tiny wrapper unit is *allowed* to pull it active.
#
# RESTORE (manual):
#   cp hyprland-session.target ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user start hyprland-session.target
# (autostart.lua already runs that last command at every login.)
# ----------------------------------------------------------------------------
[Unit]
Description=Hyprland compositor session
Documentation=man:systemd.special(7)
BindsTo=graphical-session.target
Before=graphical-session.target
