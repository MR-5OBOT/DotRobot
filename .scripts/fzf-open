#!/usr/bin/env bash

set -eo pipefail

# List directories inside ~/repos and exclude unwanted ones
selected_repo=$(find ~/repos -mindepth 1 -maxdepth 1 -type d \
	\( -name '.git' -o -name 'node_modules' \) -prune -o -type d -print |
	fzf --height 100% --reverse --prompt="Select repository: " --preview="echo {}" --preview-window=right:50%)

# Exit if no selection is made
[[ -z "$selected_repo" ]] && exit 0

# Change to the selected repo directory
cd "$selected_repo" || exit 1

# If we're already inside a tmux session, create a new window and just "cd" into the repo
if [[ -n "$TMUX" ]]; then
	tmux new-window -c "$selected_repo" "cd '$selected_repo' && $SHELL"
else
	# If no tmux session exists, notify user to create one
	if ! tmux list-sessions >/dev/null 2>&1; then
		notify-send "No active tmux session found" "Please create a new tmux session manually"
		exit 0
	fi

	# Attach to the first existing session and open a new window
	tmux attach-session -t "$(tmux list-sessions -F '#{session_name}' | head -n1)" \; \
		new-window -c "$selected_repo" "cd '$selected_repo' && $SHELL"
fi
