#!/usr/bin/env bash

set -eo pipefail

# Prompt user to select a repository from ~/repos, excluding .git and node_modules
selected_repo=$(find ~/repos -mindepth 1 -maxdepth 1 -type d \
    \( -name '.git' -o -name 'node_modules' \) -prune -o -type d -print 2>/dev/null |
    fzf --height=100% --reverse --prompt="Select repository: " \
        --preview='tree -L 2 {} | head -200' --preview-window=right:60%)

# Exit if user cancels the selection
[[ -z "$selected_repo" ]] && exit 0

# Change to selected directory
cd "$selected_repo" || exit 1

# Generate a clean window name from repo basename
window_name=$(basename "$selected_repo" | tr ' ' '-' | tr -cd '[:alnum:]-_')

# If inside a tmux session
if [[ -n "$TMUX" ]]; then
    tmux new-window -c "$selected_repo" -n "$window_name" "$SHELL -l"
    exit 0
fi

# No active session found, create one if none exists
if ! tmux has-session 2>/dev/null; then
    session_name="main"
    tmux new-session -d -s "$session_name" -c "$selected_repo" -n "$window_name" "$SHELL -l"
fi

# Attach and open new window
tmux attach-session \; new-window -c "$selected_repo" -n "$window_name" "$SHELL -l"
