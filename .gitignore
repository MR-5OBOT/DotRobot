# Runtime state written by apps into linked config dirs
dotfiles/.config/clipse/clipboard_history.json
dotfiles/.config/clipse/tmp_files/
dotfiles/.config/clipse/clipse.log
claude
# superfile drops its bundled themes + default hotkeys in on first launch
dotfiles/.config/superfile/theme/*
!dotfiles/.config/superfile/theme/black.toml

# External reference clones (quickshell migration)
quickshell-refs/

# kitty compiles any custom tab_bar.py next to the config
__pycache__/
