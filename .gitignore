# Runtime state written by apps into linked config dirs
dotfiles/.config/gtk-3.0/bookmarks
# zsh rebuilds the completion cache in $ZDOTDIR on every start
dotfiles/.config/zsh/.zcompdump*
# Safety net: Vesktop's session (Discord token) lives in ~/.config/vesktop, never here
dotfiles/.config/vesktop/*
!dotfiles/.config/vesktop/themes/

# superfile drops its bundled themes + default hotkeys in on first launch
dotfiles/.config/superfile/theme/*
!dotfiles/.config/superfile/theme/black.toml

# Python bytecode
__pycache__/
*.pyc

