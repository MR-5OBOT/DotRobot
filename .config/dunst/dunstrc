[global]
    monitor = 0
    width = 270
    height = 75
    origin = top-right
    offset = 20x20
    scale = 0
    notification_limit = 3
    frame_color = "#333333"  
    separator_color = "#333333"
    progress_bar = true
    progress_bar_height = 2
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    gap_size = 2 
    padding = 10
    horizontal_padding = 16
    text_icon_padding = 0
    frame_width = 3 
    sort = yes
    idle_threshold = 0
    font = "IosevkaTermNFMLight 10" 
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = center 
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false 
    show_indicators = yes
    icon_position = left
    min_icon_size = 0
    max_icon_size = 40
    icon_path = /usr/share/icons/Adwaita/16/status:/usr/share/icons/Adwaita/16/devices/:/usr/share/icons/Adwaita/16/apps/:/usr/share/pixmaps/  # Fixed typo: Adwita -> Adwaita
    sticky_history = false
    history_length = 10  # Increased to keep some history; set to 0 if you prefer none
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = notification
    class = Dunst
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#000000"  # Pure black
    foreground = "#FF7A84"  # Keeping your foreground color for contrast
    timeout = 3

[urgency_normal]
    background = "#000000"  # Pure black
    foreground = "#FF7A84"  # Keeping your foreground color
    timeout = 5

[urgency_critical]
    background = "#6C2020"  # Pure black (changed from reddish tint)
    foreground = "#E8E8E8"  # White for high contrast on critical notifications
    timeout = 100
