{
  "positionX": "right",
  "positionY": "top",
  "control-center-margin-top": 14,
  "control-center-margin-right": 14,
  "control-center-margin-bottom": 14,
  "control-center-width": 380,
  "control-center-height": 0,
  "fit-to-screen": true,
  "control-center-exclusive-zone": false,
  "layer-shell": true,
  "cssPriority": "user",
  "notification-window-width": 400,
  "timeout": 8,
  "timeout-low": 4,
  "widgets": [
    "buttons-grid",
    "menubar",
    "mpris",
    "dnd",
    "title",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "menubar": {
      "menu#network": {
        "label": "󰤨 WiFi",
        "position": "left",
        "animation-type": "slide_down",
        "actions": [
          { "label": "Open Network Manager", "command": "nm-applet" },
          { "label": "Connection Editor", "command": "nm-connection-editor" },
          { "label": "Turn Off WiFi", "command": "nmcli radio wifi off" }
        ]
      },
      "menu#power": {
        "label": "⏻ Power",
        "position": "right",
        "animation-type": "slide_down",
        "actions": [
          { "label": "󰌾 Lock", "command": "hyprlock" },
          { "label": "󰍃 Logout", "command": "hyprctl dispatch exit" },
          { "label": "󰑖 Reboot", "command": "systemctl reboot" },
          { "label": "󰐥 Shutdown", "command": "systemctl poweroff" }
        ]
      }
    },
    "mpris": {
      "image-size": 70,
      "image-radius": 6,
      "blur": true
    },
    "dnd": {
      "text": "Do Not Disturb"
    }
  }
}
