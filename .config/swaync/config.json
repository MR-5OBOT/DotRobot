{
  "positionX": "right",
  "positionY": "top",
  "control-center-margin-top": 10,
  "control-center-margin-right": 10,
  "control-center-margin-bottom": 10,
  "control-center-width": 390,
  "control-center-height": 0,
  "fit-to-screen": true,
  "control-center-exclusive-zone": false,
  "layer-shell": true,
  "cssPriority": "user",
  "notification-window-width": 300,
  "timeout": 8,
  "timeout-low": 4,
  "widgets": [
    "label#header",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "dnd",
    "title",
    "notifications"
  ],
  "widget-config": {
    "label#header": {
      "text": "Control Center",
      "margin-top": 5,
      "margin-bottom": 5
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰎟 Clear All"
    },
    "buttons-grid": {
      "n-columns": 2,
      "actions": [
        {
          "label": "󰖩",
          "command": "nm-connection-editor"
        },
        {
          "label": "󰂯",
          "command": "blueman-manager"
        },
        {
          "label": "󰝟",
          "command": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
        },
        {
          "label": "󰍬",
          "command": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
        },
        {
          "label": "󰐥",
          "command": "wlogout"
        }
      ]
    },
    "mpris": {
      "image-size": 64,
      "image-radius": 8,
      "blur": true
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true
    },
    "backlight": {
      "label": "󰃠"
    },
    "dnd": {
      "text": "Do Not Disturb"
    }
  }
}
