#!/usr/bin/env bash
set -eo pipefail

# Configuration
OUTPUT_DIR="$HOME/Videos/Recordings"
RESOLUTION="1920x1080"  # hd+ resolution
FPS=60                  # High frame rate
CODEC="h264_vaapi"      # Hardware accelerated encoding
QUALITY="best"          # Highest quality preset
AUDIO_SINK="alsa_output.pci-0000_00_1f.3.analog-stereo"  # Hardcoded to your system sound sink

# Create output directory
mkdir -p "$OUTPUT_DIR" || {
    notify-send -i dialog-error "Failed to create $OUTPUT_DIR"
    exit 1
}

# Check existing recording
if [ -f /tmp/recording.pid ] && kill -0 $(cat /tmp/recording.pid) 2>/dev/null; then
    notify-send -i media-record "Recording already in progress"
    exit 0
fi

# Clean stale PID
[ -f /tmp/recording.pid ] && rm /tmp/recording.pid

# Verify the sink exists
if ! pw-dump | jq -r '.[] | select(.type == "PipeWire:Interface:Node" and .info.props."media.class" == "Audio/Sink") | .info.props."node.name"' | grep -q "$AUDIO_SINK"; then
    notify-send -i dialog-error "System audio sink '$AUDIO_SINK' not found"
    echo "Sink '$AUDIO_SINK' not found in PipeWire." >> "$OUTPUT_DIR/recording.log"
    exit 1
fi

# Log the sink being used
echo "Using audio sink: $AUDIO_SINK" >> "$OUTPUT_DIR/recording.log"

# Rofi menu for audio selection
AUDIO_OPTION=$(echo -e "Record with System Sound\nRecord without Sound" | rofi -dmenu -p "Select Recording Option" -i -lines 2 -width 30)

# Check if rofi selection was canceled
if [ -z "$AUDIO_OPTION" ]; then
    notify-send -i dialog-error "Recording canceled"
    exit 0
fi

# Start recording based on selection
notify-send -i media-record "Recording Started"
case "$AUDIO_OPTION" in
    "Record with System Sound")
        wf-recorder \
            -f "$OUTPUT_DIR/rec-$(date +%Y%m%d-%H%M%S).mp4" \
            -c "$CODEC" \
            -r "$FPS" \
            -d /dev/dri/renderD128 \
            --preset "$QUALITY" \
            -g "$RESOLUTION" \
            -a "$AUDIO_SINK" &>> "$OUTPUT_DIR/recording.log" &
        ;;
    "Record without Sound")
        wf-recorder \
            -f "$OUTPUT_DIR/rec-$(date +%Y%m%d-%H%M%S).mp4" \
            -c "$CODEC" \
            -r "$FPS" \
            -d /dev/dri/renderD128 \
            --preset "$QUALITY" \
            -g "$RESOLUTION" &>> "$OUTPUT_DIR/recording.log" &
        ;;
esac

# Save PID and verify
REC_PID=$!
if kill -0 $REC_PID 2>/dev/null; then
    echo $REC_PID > /tmp/recording.pid
else
    notify-send -i dialog-error "Failed to start recording"
    exit 1
fi
