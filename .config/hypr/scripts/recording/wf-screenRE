#!/usr/bin/env bash
set -eo pipefail

# Configuration
OUTPUT_DIR="$HOME/Videos/Recordings"
RESOLUTION="1920x1080"
FPS=60
CODEC="h264_vaapi"
QUALITY="best"
VIDEO_FILE="$OUTPUT_DIR/rec-$(date +%Y%m%d-%H%M%S).mp4"
AUDIO_FILE="/tmp/audio_recording.wav"
FINAL_FILE="$OUTPUT_DIR/final-$(date +%Y%m%d-%H%M%S).mp4"

# Create output directory
mkdir -p "$OUTPUT_DIR" || {
	notify-send -i dialog-error "Error: Failed to create $OUTPUT_DIR"
	exit 1
}

# Check if a recording is already running
if [ -f /tmp/recording.pid ] && kill -0 $(cat /tmp/recording.pid) 2>/dev/null; then
	notify-send -i media-record "Recording already in progress"
	exit 0
fi

# Clean up stale PID
rm -f /tmp/recording.pid

# Select audio option using rofi
AUDIO_OPTION=$(echo -e "Record with System Sound\nRecord without Sound" | rofi -dmenu -p "Select Recording Option" -i -lines 2 -width 30)

# If selection is empty (user canceled)
if [ -z "$AUDIO_OPTION" ]; then
	notify-send -i dialog-error "Recording canceled"
	exit 0
fi

# Detect default PipeWire monitor source
AUDIO_SOURCE=$(pw-dump | jq -r '.[] | select(.info.props."media.class" == "Audio/Source") | .info.props."node.name"' | head -n1)

# Ensure PipeWire monitor source is available
if [[ "$AUDIO_OPTION" == "Record with System Sound" && -z "$AUDIO_SOURCE" ]]; then
	notify-send -i dialog-error "Error: No PipeWire audio monitor detected"
	exit 1
fi

# Start recording
notify-send -i media-record "Recording Started"
case "$AUDIO_OPTION" in
"Record with System Sound")
	# Start audio recording (correct PipeWire monitor source)
	pw-record --target="$AUDIO_SOURCE" --rate=44100 "$AUDIO_FILE" &
	AUDIO_PID=$!

	# Start video recording
	wf-recorder -f "$VIDEO_FILE" -c "$CODEC" -r "$FPS" -g "$RESOLUTION" --preset "$QUALITY" &>"$OUTPUT_DIR/recording.log" &
	VIDEO_PID=$!
	;;

"Record without Sound")
	wf-recorder -f "$VIDEO_FILE" -c "$CODEC" -r "$FPS" -g "$RESOLUTION" --preset "$QUALITY" &>"$OUTPUT_DIR/recording.log" &
	VIDEO_PID=$!
	;;
esac

# Save PID
echo $VIDEO_PID >/tmp/recording.pid
if [[ "$AUDIO_OPTION" == "Record with System Sound" ]]; then
	echo $AUDIO_PID >>/tmp/recording.pid
fi

# Wait for recording to finish
wait $VIDEO_PID

# Post-processing
if [[ "$AUDIO_OPTION" == "Record with System Sound" ]]; then
	kill $AUDIO_PID 2>/dev/null
	ffmpeg -i "$VIDEO_FILE" -i "$AUDIO_FILE" -c:v copy -c:a aac "$FINAL_FILE"
	rm -f "$AUDIO_FILE"
	notify-send -i media-record "Recording saved with audio"
else
	notify-send -i media-record "Recording saved without audio"
fi

# Cleanup
rm -f /tmp/recording.pid




