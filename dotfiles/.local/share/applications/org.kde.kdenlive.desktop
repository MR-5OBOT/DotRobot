[Desktop Entry]
Name=Kdenlive
GenericName=Video Editor
Comment=Nonlinear video editor by KDE
Type=Application
Exec=env QT_QUICK_CONTROLS_STYLE=org.kde.desktop kdenlive %F
Icon=kdenlive
StartupWMClass=kdenlive
X-DocPath=kdenlive/index.html
MimeType=application/x-kdenlive;application/vnd.mlt+xml;video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/3gpp;video/3gpp2;audio/mpeg;audio/ogg;audio/flac;audio/wav;audio/mp4;audio/x-matroska;image/gif;image/jpeg;image/png;image/webp;
Categories=Qt;KDE;AudioVideo;AudioVideoEditing;
Keywords=editing;video;audio;mlt;kde;
X-DBUS-ServiceName=org.kde.kdenlive
