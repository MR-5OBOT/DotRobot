#!/usr/bin/env bash
set -euo pipefail

# Dell Latitude 5450: stop the battery draining ~5%/hour while asleep. Dell's firmware tells Linux
# not to manage PCIe power saving (ASPM), and the NVMe sits behind Intel VMD ("RAID On"), whose link
# the BIOS keeps at full power. The CPU then never gets past package C3, so sleep never reaches
# S0ix. pcie_aspm=force lets the vmd driver power the link down. `on` checks for that exact
# combination (Intel VMD + firmware forbidding OS ASPM control) and skips any laptop without it,
# whatever the brand: not every Dell has it, and other makes can.
#
# Plain GRUB only: the option goes on one tagged line at the end of /etc/default/grub, the file
# GRUB's manual documents (/etc/default/grub.d/ is a distro patch), then grub.cfg is rebuilt.
# A boot that hangs with it: press e on the entry, delete pcie_aspm=force, Ctrl+X.

readonly PARAM=pcie_aspm=force
readonly ROOT=${SLEEP_FIX_ROOT:-} # tests point this at a fake /
readonly GRUB_DEFAULT=${ROOT}/etc/default/grub
readonly MARK="# sleep-power-drain-fix"
readonly SLEEP_SECS=60

usage() {
  cat <<'EOF'
usage: sleep-power-drain-fix [status | test | on | off]

  status   boot setting, running kernel, deep sleep since boot (default)
  test     60 s sleep test: did the SoC reach deep sleep (S0ix)?
  on       add pcie_aspm=force to the kernel options (reboot to apply)
  off      remove it again (reboot to apply)
EOF
}

die() {
  printf 'sleep-power-drain-fix: %s\n' "$*" >&2
  exit 1
}

# Ignores commented-out lines, so a disabled "#GRUB_CMDLINE...pcie_aspm=force" doesn't count.
has_param() { grep -sv '^[[:space:]]*#' "$1" | grep -qw -- "${PARAM}"; }

hw_sleep_us() { cat "${ROOT}/sys/power/suspend_stats/total_hw_sleep" 2>/dev/null || echo 0; }

# Does this laptop have the problem? An SSD bound to Intel VMD, and firmware whose FADT sets
# ACPI_FADT_NO_ASPM: bit 4 of the IA-PC boot flags, a 16-bit field at byte 109 (ACPI spec layout,
# so kernel updates can't move it). The table is root-only, hence sudo.
needs_fix() {
  local flags
  compgen -G "${ROOT}/sys/bus/pci/drivers/vmd/*:*" >/dev/null || return 1
  flags=$(sudo od -An -tu2 -j109 -N2 "${ROOT}/sys/firmware/acpi/tables/FACP" 2>/dev/null) || return 1
  [[ -n ${flags// /} ]] && ((flags & 16))
}

# A UKI boots with its own built-in options, so a GRUB edit would do nothing there.
check_grub() {
  if grep -Eqs '^[[:space:]]*[a-z]+_uki=' "${ROOT}"/etc/mkinitcpio.d/*.preset || [[ ! -f ${GRUB_DEFAULT} ]]; then
    die "works only with plain GRUB; add ${PARAM} to your kernel options by hand"
  fi
}

status() {
  local boot=off running=off
  has_param "${GRUB_DEFAULT}" && boot=on
  has_param "${ROOT}/proc/cmdline" && running=on
  echo "boot setting:          ${boot}"
  echo "running kernel:        ${running}"
  echo "deep sleep since boot: $(($(hw_sleep_us) / 1000000))s (stays 0 while sleep is broken)"
}

on() {
  check_grub
  if has_param "${GRUB_DEFAULT}"; then
    echo "already on"
    return
  fi
  if ! needs_fix; then
    echo "skipped: this laptop doesn't have the problem this fixes (needs an SSD behind Intel VMD and firmware that forbids OS ASPM control)"
    return
  fi
  # a file missing its last newline would glue our line onto its last one
  [[ -z $(tail -c1 "${GRUB_DEFAULT}") ]] || echo | sudo tee -a "${GRUB_DEFAULT}" >/dev/null
  # shellcheck disable=SC2016 # grub-mkconfig expands it when it sources /etc/default/grub
  printf 'GRUB_CMDLINE_LINUX_DEFAULT="${GRUB_CMDLINE_LINUX_DEFAULT} %s" %s\n' "${PARAM}" "${MARK}" | sudo tee -a "${GRUB_DEFAULT}" >/dev/null
  sudo grub-mkconfig -o /boot/grub/grub.cfg
  echo "fix on: reboot to apply"
}

off() {
  check_grub
  if ! has_param "${GRUB_DEFAULT}"; then
    echo "already off"
    return
  fi
  sudo sed -i "/${MARK}\$/d" "${GRUB_DEFAULT}"
  has_param "${GRUB_DEFAULT}" && echo "warning: ${PARAM} is also set by hand in ${GRUB_DEFAULT}; remove it there too"
  sudo grub-mkconfig -o /boot/grub/grub.cfg
  echo "fix off: reboot to apply"
}

# 0 = the SoC reached hardware sleep (S0ix), 1 = it didn't, 2 = the test sleep itself failed.
# Compares total_hw_sleep across the sleep, so a refused or interrupted suspend can't pass on a
# previous sleep's number. On a fail, intel_pmc_core's warning names what stopped it.
sleep_test() {
  local start before after
  echo "Sleeping ${SLEEP_SECS}s: the screen goes black and wakes by itself. Don't close the lid."
  echo 1 | sudo tee "${ROOT}/sys/module/intel_pmc_core/parameters/warn_on_s0ix_failures" >/dev/null 2>&1 || true
  before=$(hw_sleep_us)
  start=$(date +%s)
  if ! sudo rtcwake -m freeze -s "${SLEEP_SECS}" >/dev/null; then
    echo "The test sleep didn't happen (suspend refused or interrupted); run test again."
    return 2
  fi
  after=$(hw_sleep_us)
  echo "deep sleep: $(((after - before) / 1000000))s of ${SLEEP_SECS}s"
  ((after > before)) && return 0
  journalctl -k --since "@${start}" --no-pager -o cat 2>/dev/null | grep "did not enter" || true
  return 1
}

test_fix() {
  local rc=0
  sleep_test || rc=$?
  case ${rc} in
    0) echo "PASS: deep sleep works." ;;
    1)
      if has_param "${ROOT}/proc/cmdline"; then
        echo "FAIL: deep sleep is broken even with the fix running."
      else
        echo "FAIL: deep sleep is broken. Turn the fix on (sleep-power-drain-fix on), reboot, test again."
      fi
      ;;
  esac
  return "${rc}"
}

case "${1:-status}" in
  status) status ;;
  test) test_fix ;;
  on) on ;;
  off) off ;;
  -h | --help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
