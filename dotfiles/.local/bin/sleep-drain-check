#!/usr/bin/env python3
"""
What each sleep costs in battery. Nothing runs in the background: the kernel already
logs every suspend and UPower already stores the battery level, so this just pairs
them. For the most recent sleep the kernel's own counter also says how much of it was
real deep sleep (S0ix); 0 there means the laptop merely idled with the screen off.

Usage: sleep-drain-check [days]   (default 3)
"""

import os
import re
import subprocess
import sys
import time

ROOT = os.environ.get("SLEEP_DRAIN_ROOT", "")
DAYS = float(sys.argv[1]) if len(sys.argv) > 1 else 3
# Under a quarter hour the battery percentage barely moves, so a rate would be noise.
MIN_RATE_HOURS = 0.25


def run(cmd):
    return subprocess.run(cmd, text=True, capture_output=True).stdout


def source(env_var, cmd):
    path = os.environ.get(env_var)
    return open(path).read() if path else run(cmd)


def sleep_windows():
    """(start, end) of every suspend the journal still has, oldest first."""
    text = source("SLEEP_DRAIN_JOURNAL",
                  ["journalctl", "-k", "--since", f"-{DAYS} days", "-o", "short-unix", "--no-pager"])
    out, start = [], None
    for line in text.splitlines():
        stamp = line.split(" ", 1)[0]
        try:
            when = float(stamp)
        except ValueError:
            continue
        if "PM: suspend entry" in line:
            start = when
        elif "PM: suspend exit" in line and start:
            out.append((start, when))
            start = None
    return out


def charge_readings():
    """(time, percentage) UPower recorded, oldest first."""
    dev = next((word for word in run(["upower", "-e"]).split() if "battery" in word), "")
    text = source("SLEEP_DRAIN_HISTORY",
                  ["gdbus", "call", "--system", "--dest", "org.freedesktop.UPower", "--object-path", dev,
                   "--method", "org.freedesktop.UPower.Device.GetHistory", "charge", str(int(DAYS * 86400)), "20000"])
    found = re.findall(r"\((?:uint32 )?(\d+), ([\d.]+), (?:uint32 )?\d+\)", text)
    return sorted((int(t), float(v)) for t, v in found)


def read_int(path):
    try:
        with open(ROOT + path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return 0


def nearest(readings, when, before):
    """The reading closest to `when` on the asked side, within half an hour of it."""
    side = [r for r in readings if (r[0] <= when if before else r[0] >= when)]
    if not side:
        return None
    pick = side[-1] if before else side[0]
    return pick if abs(pick[0] - when) <= 1800 else None


def main():
    windows, readings = sleep_windows(), charge_readings()
    if not windows:
        print(f"no sleeps in the last {DAYS:g} days")
        return
    last_hw = read_int("/sys/power/suspend_stats/last_hw_sleep") / 1e6

    print("      sleep started   length   battery        drain")
    for index, (start, end) in enumerate(windows):
        hours = (end - start) / 3600
        before, after = nearest(readings, start, True), nearest(readings, end, False)
        if before and after and hours >= MIN_RATE_HOURS:
            level = f"{before[1]:.0f}% -> {after[1]:.0f}%"
            rate = f"{(before[1] - after[1]) / hours:+.1f} %/h"
        else:
            level, rate = ("-", "too short" if hours < MIN_RATE_HOURS else "no battery reading")
        mark = " <- last" if index == len(windows) - 1 else ""
        print(f"  {time.strftime('%m-%d %H:%M', time.localtime(start))}  {hours * 60:7.0f} min  {level:<14} {rate}{mark}")

    start, end = windows[-1]
    length = end - start
    share = f"{100 * last_hw / length:.0f}%" if length else "-"
    print(f"\nlast sleep: {last_hw:.0f}s of {length:.0f}s in deep sleep ({share}). 0 means deep sleep is broken.")


if __name__ == "__main__":
    main()
