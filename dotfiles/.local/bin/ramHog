#!/usr/bin/env bash

BLD='\033[1m'; RST='\033[0m'
GRN='\033[0;32m'; YEL='\033[0;33m'; RED='\033[0;31m'

echo
echo -e "${BLD}── RAM by Application (all instances summed) ────────${RST}"
printf "\n  ${BLD}%-20s %10s %8s  %s${RST}\n" "APP" "Total MiB" "Instances" "PIDs"
echo "  ──────────────────────────────────────────────────"

# PIDs column lists only root processes: those whose parent is a different app
# Name last and tab-separated after: names can hold spaces ("tmux: server")
ps -eo pid=,ppid=,rss=,comm= \
  | awk '{c=$4; for(i=5;i<=NF;i++) c=c" "$i; pid[NR]=$1; ppid[$1]=$2; comm[$1]=c; sum[c]+=$3; count[c]++}
         END {
           for(i=1;i<=NR;i++){p=pid[i]; c=comm[p]; if(comm[ppid[p]]!=c) roots[c]=roots[c] (roots[c] ? "," : "") p}
           for(k in sum) printf "%s\t%d\t%d\t%s\n", k, sum[k], count[k], roots[k]
         }' \
  | sort -t$'\t' -k2,2rn \
  | head -20 \
  | while IFS=$'\t' read -r name total_kb count pids; do
      mb="$((total_kb / 1024)).$((total_kb % 1024 * 10 / 1024))"
      color=$GRN
      (( total_kb > 1000000 )) && color=$RED
      (( total_kb > 200000 && total_kb <= 1000000 )) && color=$YEL
      printf "  ${color}%-20s %10s %8s  %s${RST}\n" \
        "${name:0:20}" "${mb} MiB" "x${count}" "$pids"
    done

echo
