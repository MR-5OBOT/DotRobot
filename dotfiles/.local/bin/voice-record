#!/usr/bin/env bash
set -euo pipefail

mic="${VOICE_SOURCE:-alsa_input.pci-0000_00_1f.3.analog-stereo}"
pactl set-default-source "$mic"
pactl set-source-mute "$mic" 0
gsettings set org.gnome.SoundRecorder audio-profile mp3
gsettings set org.gnome.SoundRecorder audio-channel mono
exec gnome-sound-recorder
