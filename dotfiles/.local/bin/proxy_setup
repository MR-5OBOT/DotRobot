#!/bin/zsh

# Function to display usage
usage() {
    echo "Usage: $0 {set|reset}"
    echo "  set   - Set up proxy with user-provided IP and port"
    echo "  reset - Remove proxy settings"
    exit 1
}

# Proxy setup function
setup_proxy() {
    # Prompt user for proxy IP and port
    echo -n "Enter the proxy IP address: "
    read PROXY_IP
    if [ -z "$PROXY_IP" ]; then
        echo "Error: Proxy IP cannot be empty"
        exit 1
    fi

    echo -n "Enter the proxy port (default is 8080): "
    read PROXY_PORT
    PROXY_PORT=${PROXY_PORT:-8080} # Default to 8080 if no input

    PROXY_URL="http://$PROXY_IP:$PROXY_PORT"

    # Set environment variables for current session
    export http_proxy="$PROXY_URL"
    export https_proxy="$PROXY_URL"
    export HTTP_PROXY="$PROXY_URL"
    export HTTPS_PROXY="$PROXY_URL"

    # Add to /etc/environment for system-wide settings
    if ! grep -q "http_proxy" /etc/environment; then
        echo "Adding proxy settings to /etc/environment"
        sudo sh -c "echo 'http_proxy=\"$PROXY_URL\"' >> /etc/environment"
        sudo sh -c "echo 'https_proxy=\"$PROXY_URL\"' >> /etc/environment"
        sudo sh -c "echo 'HTTP_PROXY=\"$PROXY_URL\"' >> /etc/environment"
        sudo sh -c "echo 'HTTPS_PROXY=\"$PROXY_URL\"' >> /etc/environment"
    else
        echo "Updating proxy settings in /etc/environment"
        sudo sed -i "/http_proxy=/c\http_proxy=\"$PROXY_URL\"" /etc/environment
        sudo sed -i "/https_proxy=/c\https_proxy=\"$PROXY_URL\"" /etc/environment
        sudo sed -i "/HTTP_PROXY=/c\HTTP_PROXY=\"$PROXY_URL\"" /etc/environment
        sudo sed -i "/HTTPS_PROXY=/c\HTTPS_PROXY=\"$PROXY_URL\"" /etc/environment
    fi

    # Add to ~/.zshrc for user-specific Zsh sessions
    if ! grep -q "http_proxy" ~/.zshrc; then
        echo "Adding proxy settings to ~/.zshrc"
        echo "export http_proxy=\"$PROXY_URL\"" >> ~/.zshrc
        echo "export https_proxy=\"$PROXY_URL\"" >> ~/.zshrc
        echo "export HTTP_PROXY=\"$PROXY_URL\"" >> ~/.zshrc
        echo "export HTTPS_PROXY=\"$PROXY_URL\"" >> ~/.zshrc
    else
        echo "Updating proxy settings in ~/.zshrc"
        sed -i "/http_proxy=/c\export http_proxy=\"$PROXY_URL\"" ~/.zshrc
        sed -i "/https_proxy=/c\export https_proxy=\"$PROXY_URL\"" ~/.zshrc
        sed -i "/HTTP_PROXY=/c\export HTTP_PROXY=\"$PROXY_URL\"" ~/.zshrc
        sed -i "/HTTPS_PROXY=/c\export HTTPS_PROXY=\"$PROXY_URL\"" ~/.zshrc
    fi

    echo "Proxy set to: $PROXY_URL"
}

# Proxy reset function
reset_proxy() {
    # Unset environment variables
    unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY

    # Remove from /etc/environment
    sudo sed -i '/http_proxy/d;/https_proxy/d;/HTTP_PROXY/d;/HTTPS_PROXY/d' /etc/environment

    # Remove from ~/.zshrc
    sed -i '/http_proxy/d;/https_proxy/d;/HTTP_PROXY/d;/HTTPS_PROXY/d' ~/.zshrc

    echo "Proxy settings removed"
}

# Main logic
if [ $# -ne 1 ]; then
    usage
fi

case "$1" in
set)
    setup_proxy
    ;;
reset)
    reset_proxy
    ;;
*)
    usage
    ;;
esac
