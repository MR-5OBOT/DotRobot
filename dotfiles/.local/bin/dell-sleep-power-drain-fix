#!/usr/bin/env bash
set -euo pipefail

# Dell Latitude 5450: stop the battery draining ~5%/hour while asleep. Dell's firmware tells Linux
# not to manage PCIe power saving (ASPM), and the NVMe sits behind Intel VMD ("RAID On"), whose link
# the BIOS keeps at full power. The CPU then never gets past package C3, so sleep never reaches
# S0ix. pcie_aspm=force lets the vmd driver power the link down. Other laptops: don't run this.
#
# Where the option goes, each one documented by its own tool, so updates keep honouring it:
#   plain GRUB  one tagged line at the end of /etc/default/grub (then grub.cfg is rebuilt);
#               /etc/default/grub.d/ would be tidier but is a distro patch, not upstream GRUB
#   UKI         /etc/cmdline.d/dell-sleep.conf (then the UKI is rebuilt)
# A boot that hangs with it on plain GRUB: press e on the entry, delete pcie_aspm=force, Ctrl+X.

readonly PARAM=pcie_aspm=force
readonly ROOT=${DELL_SLEEP_FIX_ROOT:-} # tests point this at a fake /
readonly GRUB_DEFAULT=${ROOT}/etc/default/grub
readonly MARK="# dell-sleep-power-drain-fix"
readonly UKI_DROPIN=${ROOT}/etc/cmdline.d/dell-sleep.conf
readonly LEGACY=${ROOT}/etc/kernel/cmdline # where older versions of this script put it (UKI only)
readonly SLEEP_SECS=60

usage() {
  cat <<'EOF'
usage: dell-sleep-power-drain-fix [status | test | on | off]

  status   boot setup, boot setting, running kernel, deep sleep since boot (default)
  test     60 s sleep test: did the SoC reach deep sleep (S0ix)?
  on       add pcie_aspm=force to the kernel options (reboot to apply)
  off      remove it again (reboot to apply)
EOF
}

die() {
  printf 'dell-sleep-power-drain-fix: %s\n' "$*" >&2
  exit 1
}

# Ignores commented-out lines, so a disabled "#GRUB_CMDLINE...pcie_aspm=force" doesn't count.
has_param() { grep -sv '^[[:space:]]*#' "$1" | grep -qw -- "${PARAM}"; }

hw_sleep_us() { cat "${ROOT}/sys/power/suspend_stats/total_hw_sleep" 2>/dev/null || echo 0; }

# UKI when a mkinitcpio preset builds one; its options come from the cmdline files, not GRUB's.
uses_uki() { grep -Eqs '^[[:space:]]*[a-z]+_uki=' "${ROOT}"/etc/mkinitcpio.d/*.preset; }

# The file that holds the option on this setup.
target() {
  if uses_uki; then
    echo "${UKI_DROPIN}"
  elif [[ -f ${GRUB_DEFAULT} ]]; then
    echo "${GRUB_DEFAULT}"
  else
    die "found neither a UKI preset nor /etc/default/grub; add ${PARAM} to your kernel options by hand"
  fi
}

configured() {
  local f
  f=$(target) || exit 1
  has_param "${f}" || { uses_uki && has_param "${LEGACY}"; }
}

rebuild() {
  if uses_uki; then
    sudo mkinitcpio -P
  else
    sudo grub-mkconfig -o /boot/grub/grub.cfg
  fi
}

status() {
  local setup="plain GRUB" boot=off running=off
  uses_uki && setup=UKI
  configured && boot=on
  has_param "${ROOT}/proc/cmdline" && running=on
  echo "boot setup:            ${setup}"
  echo "boot setting:          ${boot}"
  echo "running kernel:        ${running}"
  echo "deep sleep since boot: $(($(hw_sleep_us) / 1000000))s (stays 0 while sleep is broken)"
}

on() {
  local f
  f=$(target)
  if configured; then
    echo "already on"
    return
  fi
  if [[ ${f} == "${GRUB_DEFAULT}" ]]; then
    # a file missing its last newline would glue our line onto its last one
    [[ -z $(tail -c1 "${f}") ]] || echo | sudo tee -a "${f}" >/dev/null
    # shellcheck disable=SC2016 # grub-mkconfig expands it when it sources /etc/default/grub
    printf 'GRUB_CMDLINE_LINUX_DEFAULT="${GRUB_CMDLINE_LINUX_DEFAULT} %s" %s\n' "${PARAM}" "${MARK}" | sudo tee -a "${f}" >/dev/null
  else
    sudo mkdir -p "${f%/*}"
    printf '%s\n' "${PARAM}" | sudo tee "${f}" >/dev/null
  fi
  rebuild
  echo "fix on: reboot to apply"
}

off() {
  local f
  f=$(target)
  if ! configured; then
    echo "already off"
    return
  fi
  if [[ ${f} == "${GRUB_DEFAULT}" ]]; then
    sudo sed -i "/${MARK}\$/d" "${f}"
    has_param "${f}" && echo "warning: ${PARAM} is also set by hand in ${f}; remove it there too"
  else
    sudo rm -f "${f}"
  fi
  if uses_uki && has_param "${LEGACY}"; then
    sudo sed -i "s/[[:space:]]*${PARAM}//" "${LEGACY}"
  fi
  rebuild
  echo "fix off: reboot to apply"
}

# 0 = the SoC reached hardware sleep (S0ix), 1 = it didn't, 2 = the test sleep itself failed.
# Compares total_hw_sleep across the sleep, so a refused or interrupted suspend can't pass on a
# previous sleep's number. On a fail, intel_pmc_core's warning names what stopped it.
sleep_test() {
  local start before after
  echo "Sleeping ${SLEEP_SECS}s: the screen goes black and wakes by itself. Don't close the lid."
  echo 1 | sudo tee "${ROOT}/sys/module/intel_pmc_core/parameters/warn_on_s0ix_failures" >/dev/null 2>&1 || true
  before=$(hw_sleep_us)
  start=$(date +%s)
  if ! sudo rtcwake -m freeze -s "${SLEEP_SECS}" >/dev/null; then
    echo "The test sleep didn't happen (suspend refused or interrupted); run test again."
    return 2
  fi
  after=$(hw_sleep_us)
  echo "deep sleep: $(((after - before) / 1000000))s of ${SLEEP_SECS}s"
  ((after > before)) && return 0
  journalctl -k --since "@${start}" --no-pager -o cat 2>/dev/null | grep "did not enter" || true
  return 1
}

test_fix() {
  local rc=0
  sleep_test || rc=$?
  case ${rc} in
    0) echo "PASS: deep sleep works." ;;
    1)
      if has_param "${ROOT}/proc/cmdline"; then
        echo "FAIL: deep sleep is broken even with the fix running."
      else
        echo "FAIL: deep sleep is broken. Turn the fix on (dell-sleep-power-drain-fix on), reboot, test again."
      fi
      ;;
  esac
  return "${rc}"
}

case "${1:-status}" in
  status) status ;;
  test) test_fix ;;
  on) on ;;
  off) off ;;
  -h | --help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
