#!/usr/bin/env bash
set -euo pipefail

# The GS25F2A's speakers can go silent after a long no-signal stretch (screen off / suspend) even though the PC is
# still sending HDMI audio. Toggling the monitor's own mute over DDC/CI sometimes wakes them; when it doesn't,
# a soft power cycle (same as the monitor's power button) is the last try before pulling the power cable.
ddcutil --model GS25F2A setvcp 8D 01
ddcutil --model GS25F2A setvcp 8D 02

echo "Turning the monitor off for 30 s..."
# With the lid closed, the monitor going dark can count as undocked and logind would suspend the laptop.
systemd-inhibit --what=handle-lid-switch --why="monitor power cycle" bash -c '
  ddcutil --model GS25F2A setvcp D6 05
  sleep 30
  ddcutil --model GS25F2A setvcp D6 01
' || echo "Couldn't turn the monitor back on: press its power button."
