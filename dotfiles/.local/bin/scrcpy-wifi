#!/bin/bash
# scrcpy-wifi — mirror an Android phone over Wi-Fi, robust across PC/phone reboots.
#
# NOTE: this machine's adb has NO mDNS backend ("adb mdns check" fails), so this
# does NOT rely on mDNS discovery. It anchors on a fixed TCP/IP port (5555).
#
# Reconnect order (fastest/most reliable first):
#   0. Explicit address arg     scrcpy-wifi 192.168.0.105:45321
#   1. Last working address     (cache)        -> instant, the normal case
#   2. Last IP : 5555           (fixed port)    -> survives a PC reboot
#   3. Subnet scan for :5555                     -> survives a changed phone IP
#   4. USB fallback: adb tcpip 5555              -> recover after a phone reboot
#
# After a PHONE REBOOT Android clears the fixed port. Re-arm it by plugging USB
# in once and rerunning; or read IP address & Port off the phone's Wireless-
# debugging screen and pass it:  scrcpy-wifi <ip:port>
#
# Extra scrcpy flags pass straight through:  scrcpy-wifi --turn-screen-off

set -uo pipefail

PORT=5555
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/scrcpy-wifi"
STATE_FILE="$STATE_DIR/last"
mkdir -p "$STATE_DIR"

# Quality defaults — tweak to taste, or override per-run via CLI args.
SCRCPY_OPTS=(--max-size 1920 --max-fps 60 --video-bit-rate 8M --turn-screen-off)

log() { printf '\033[1;35m::\033[0m %s\n' "$*"; }      # muted pink prefix
err() { printf '\033[1;31m!!\033[0m %s\n' "$*" >&2; }

adb start-server >/dev/null 2>&1

is_online() {
    adb devices | awk -v d="$1" '$1==d && $2=="device"{ok=1} END{exit !ok}'
}

try_connect() {
    local addr="$1"
    [ -n "$addr" ] || return 1
    adb connect "$addr" 2>/dev/null | grep -qiE 'connected to' || return 1
    is_online "$addr"
}

# Explicit IP:port target as $1 (remaining args are passed to scrcpy).
TARGET=""
if [[ "${1:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+$ ]]; then
    TARGET="$1"; shift
fi

DEVICE=""

# 0) Explicit target ---------------------------------------------------------
if [ -n "$TARGET" ]; then
    log "Connecting to $TARGET"
    try_connect "$TARGET" && DEVICE="$TARGET"
fi

# 1) Cached exact address ----------------------------------------------------
if [ -z "$DEVICE" ] && [ -f "$STATE_FILE" ]; then
    addr=$(< "$STATE_FILE")
    log "Trying last device: $addr"
    try_connect "$addr" && DEVICE="$addr"
fi

# 2) Cached IP on the fixed port --------------------------------------------
if [ -z "$DEVICE" ] && [ -f "$STATE_FILE" ]; then
    ip=$(cut -d: -f1 < "$STATE_FILE")
    if [ -n "$ip" ] && [ "$ip:$PORT" != "$(< "$STATE_FILE")" ]; then
        log "Trying fixed port: $ip:$PORT"
        try_connect "$ip:$PORT" && DEVICE="$ip:$PORT"
    fi
fi

# 3) Scan the local /24 for an open fixed port (handles a changed phone IP) --
if [ -z "$DEVICE" ]; then
    base=$(ip -o -4 addr show 2>/dev/null | awk '!/ lo /{print $4; exit}' \
           | cut -d/ -f1 | cut -d. -f1-3)
    if [ -n "$base" ]; then
        log "Scanning $base.0/24 for :$PORT ..."
        scan=$(mktemp)
        for i in $(seq 1 254); do
            ( timeout 0.3 bash -c "exec 3<>/dev/tcp/$base.$i/$PORT" 2>/dev/null \
              && echo "$base.$i" ) >>"$scan" &
        done
        wait
        ip=$(head -n1 "$scan"); rm -f "$scan"
        if [ -n "$ip" ]; then
            log "Found :$PORT open on $ip"
            try_connect "$ip:$PORT" && DEVICE="$ip:$PORT"
        fi
    fi
fi

# 4) USB fallback: arm tcpip on the fixed port ------------------------------
if [ -z "$DEVICE" ]; then
    usb=$(adb devices | awk '$2=="device" && $1 !~ /:/{print $1; exit}')
    if [ -n "$usb" ]; then
        ip=$(adb -s "$usb" shell ip route 2>/dev/null | tr -d '\r' \
             | awk '/wlan0/{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
        if [ -n "$ip" ]; then
            log "USB $usb -> arming tcpip $ip:$PORT"
            adb -s "$usb" tcpip "$PORT" >/dev/null 2>&1
            sleep 1
            try_connect "$ip:$PORT" && DEVICE="$ip:$PORT"
        else
            err "Couldn't read the phone's Wi-Fi IP over USB (is Wi-Fi on?)."
        fi
    fi
fi

if [ -z "$DEVICE" ]; then
    err "No Android device reachable over Wi-Fi."
    cat >&2 <<EOF

Recover one of these ways:
  - Plug USB in once and rerun (re-arms the fixed port $PORT). Best option.
  - Or read IP address & Port from the phone's Wireless-debugging screen:
        scrcpy-wifi <ip:port>

Tip: give the phone a static IP / DHCP reservation in your router so its
address never changes -- then it reconnects instantly after a PC reboot.
EOF
    exit 1
fi

echo "$DEVICE" > "$STATE_FILE"
log "Connected: $DEVICE"
exec scrcpy -s "$DEVICE" "${SCRCPY_OPTS[@]}" "$@"
