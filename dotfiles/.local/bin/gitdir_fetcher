#!/usr/bin/env bash
# git_dir_fetcher — Download a GitHub subdirectory from a URL
# Usage: git_dir_fetcher <github_url> [output_dir]

set -e

URL="$1"
OUTPUT="${2:-.}"

if [[ -z "$URL" ]]; then
  echo "Usage: git_dir_fetcher <github_url> [output_dir]"
  echo "Example: git_dir_fetcher https://github.com/user/repo/tree/master/some/dir"
  exit 1
fi

# Pick runner
if command -v bunx &>/dev/null; then
  RUNNER="bunx"
elif command -v npx &>/dev/null; then
  RUNNER="npx"
else
  echo "✗ Neither bunx nor npx found. Install Bun or Node.js."
  exit 1
fi

# Parse URL
STRIPPED="${URL#https://github.com/}"
USER_REPO=$(echo "$STRIPPED" | cut -d'/' -f1-2)
BRANCH=$(echo "$STRIPPED" | cut -d'/' -f4)
DIR_PATH=$(echo "$STRIPPED" | cut -d'/' -f5-)

DEGIT_TARGET="${USER_REPO}/${DIR_PATH}#${BRANCH}"

echo "→ Runner : $RUNNER"
echo "→ Repo   : $USER_REPO"
echo "→ Branch : $BRANCH"
echo "→ Path   : $DIR_PATH"
echo "→ Output : $OUTPUT"
echo ""

$RUNNER degit "$DEGIT_TARGET" "$OUTPUT" --force
echo "✓ Done"
