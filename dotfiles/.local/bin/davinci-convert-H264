#!/usr/bin/env bash

# ============================================================================
# davinci-convert
# ============================================================================
#
# Purpose:
#   Convert H.264 / H.265 / common OBS recordings into a DaVinci Resolve-
#   friendly editing format for Linux.
#
# Target system:
#   Dell Latitude 5450
#   CPU: Intel Core i5-1335U (13th Gen)
#   GPU: Intel Iris Xe integrated graphics
#   RAM: 16 GB
#   OS: Arch Linux + Hyprland / Wayland
#
# DaVinci Resolve target:
#   Free Linux version
#
# Why this script exists:
#   DaVinci Resolve Free on Linux has limited support for common H.264/H.265
#   and AAC media. OBS recordings may therefore fail to import even though
#   the Intel GPU and VA-API drivers support those codecs.
#
# Conversion profile:
#   Container:     MOV
#   Video codec:   DNxHR SQ
#   Pixel format:  yuv422p
#   Audio codec:   PCM 16-bit
#   Resolution:    Preserve source resolution
#   Frame rate:    Preserve source frame rate
#
# Why DNxHR SQ:
#   - Better suited than DNxHR LB as the main editing source
#   - Preserves small text, trading charts, candles, UI elements and numbers
#     better than the lower-bitrate LB profile
#   - Much easier for the i5-1335U / Iris Xe system to edit than highly
#     compressed delivery codecs such as H.264/H.265
#   - Good balance of editing performance and quality for 1080p60 footage
#
# Intended workload:
#   - OBS screen recordings
#   - Trading/chart recordings
#   - 1080p60 footage
#   - Cuts, crops, zooms, text, overlays and light effects
#
# Trade-off:
#   DNxHR SQ files are significantly larger than the original H.264/H.265
#   recordings. This is expected because DNxHR is designed for editing rather
#   than compact storage.
#
# Usage:
#   davinci-convert "video.mkv"
#   davinci-convert "video 1.mkv" "video 2.mp4"
#
# Output:
#   video-resolve.mov
#
# Requirements:
#   ffmpeg
#
# Arch Linux:
#   sudo pacman -S ffmpeg
#
# ============================================================================

set -euo pipefail

usage() {
  cat <<'EOF'
davinci-convert - Convert videos to DaVinci Resolve-friendly MOV files

Usage:
  davinci-convert FILE [FILE2 ...]

Examples:
  davinci-convert "video.mkv"
  davinci-convert clip1.mp4 clip2.mkv

Output:
  input-file-resolve.mov

Codec settings:
  Video: DNxHR SQ
  Pixel format: yuv422p
  Audio: PCM s16le
EOF
}

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "Error: ffmpeg is not installed."
  echo "Install it with: sudo pacman -S ffmpeg"
  exit 1
fi

if [ "$#" -lt 1 ]; then
  usage
  exit 1
fi

for input in "$@"; do
  if [ ! -f "$input" ]; then
    echo "Skipping: file not found -> $input"
    continue
  fi

  dir="$(dirname "$input")"
  filename="$(basename "$input")"
  stem="${filename%.*}"

  output="$dir/${stem}-resolve.mov"
  n=1

  while [ -e "$output" ]; do
    output="$dir/${stem}-resolve-$n.mov"
    n=$((n + 1))
  done

  echo "Converting:"
  echo "  Input : $input"
  echo "  Output: $output"

  ffmpeg -hide_banner -y \
    -i "$input" \
    -map 0:v:0 \
    -map 0:a? \
    -c:v dnxhd \
    -profile:v dnxhr_sq \
    -pix_fmt yuv422p \
    -c:a pcm_s16le \
    "$output"

  echo "Done: $output"
  echo
done
