#!/usr/bin/env bash
set -euo pipefail

# Switch power-profiles-daemon profiles and flash the change in the quickshell
# OSD. Goes through powerprofilesctl rather than sysfs because the Dell and the
# ThinkPad name their firmware profiles differently; ppd maps both.

readonly ORDER=(power-saver balanced performance)

usage() {
  cat <<'EOF'
usage: powerprofile [get | menu | next | prev | list | <profile>]

  get         print the active profile (default)
  menu        quickshell picker: repeat to move down, Enter to apply
              (plain `next` when quickshell is not running)
  next, prev  step power-saver -> balanced -> performance, wrapping around
  list        show available profiles, * marks the active one
  <profile>   power-saver | balanced | performance
              (short: saver, low | bal | perf, high)
EOF
}

die() {
  printf 'powerprofile: %s\n' "$*" >&2
  exit 1
}

# Flash the OSD island; it reads the profile itself. No-op if qs is down.
osd() { qs ipc call osd power >/dev/null 2>&1 || true; }

current() { powerprofilesctl get; }

# Profiles this machine offers, in ORDER. performance is absent on hardware
# without a performance driver, so the cycle must not assume it.
available() {
  local offered profile
  offered=$(powerprofilesctl list | sed -n 's/^[* ] \([a-z-]*\):$/\1/p')
  for profile in "${ORDER[@]}"; do
    if grep -qx "${profile}" <<<"${offered}"; then
      echo "${profile}"
    fi
  done
}

# Why ppd is holding performance back (lap-detected, high-operating-temperature);
# empty when it isn't.
degraded_reason() {
  powerprofilesctl list | awk '
    /^[* ] [a-z-]+:$/ { in_perf = ($NF == "performance:") }
    in_perf && $1 == "Degraded:" && $2 == "yes" { gsub(/[()]/, "", $3); print $3 }'
}

resolve() {
  case "$1" in
    power-saver | saver | low) echo power-saver ;;
    balanced | bal) echo balanced ;;
    performance | perf | high) echo performance ;;
    *) die "unknown profile '$1' (see: powerprofile --help)" ;;
  esac
}

set_profile() {
  local target=$1 reason
  grep -qx "${target}" <<<"$(available)" || die "${target} is not available on this machine"
  [[ $(current) == "${target}" ]] || powerprofilesctl set "${target}"
  osd
  echo "${target}"

  if [[ ${target} == performance ]]; then
    reason=$(degraded_reason)
    if [[ -n ${reason} ]]; then
      printf 'powerprofile: performance is degraded (%s)\n' "${reason}" >&2
      notify-send -a powerprofile "Performance degraded" "${reason}" 2>/dev/null || true
    fi
  fi
}

# $1 = +1 or -1 steps through ORDER, skipping profiles this machine lacks.
step() {
  local -a profiles
  local cur n i=0
  mapfile -t profiles < <(available)
  n=${#profiles[@]}
  ((n > 0)) || die "power-profiles-daemon reports no profiles"
  cur=$(current)
  while ((i < n)) && [[ ${profiles[i]} != "${cur}" ]]; do
    i=$((i + 1))
  done
  set_profile "${profiles[(i + $1 + n) % n]}"
}

# Hand off to PowerProfileMenu.qml. `qs ipc call` exits 0 even when the target
# is missing (it prints "Target not found." instead), so any output counts as
# a failure. Without qs (a TTY, or the shell is down) fall back to a step.
menu() {
  local out
  if out=$(qs ipc call powerprofile cycle 2>&1) && [[ -z ${out} ]]; then
    return
  fi
  step 1
}

list() {
  local cur profile
  cur=$(current)
  for profile in $(available); do
    if [[ ${profile} == "${cur}" ]]; then
      echo "* ${profile}"
    else
      echo "  ${profile}"
    fi
  done
}

main() {
  command -v powerprofilesctl >/dev/null || die "powerprofilesctl not found; install power-profiles-daemon"

  case "${1:-get}" in
    get) current ;;
    menu) menu ;;
    next) step 1 ;;
    prev) step -1 ;;
    list) list ;;
    -h | --help) usage ;;
    *)
      local target
      target=$(resolve "$1")
      set_profile "${target}"
      ;;
  esac
}

main "$@"
