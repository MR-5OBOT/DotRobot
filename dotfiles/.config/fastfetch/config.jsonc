// Inspired by Catnap
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // kitty-icat, not kitty/kitty-direct: `kitten icat` defaults to
  // --passthrough=detect, which in tmux implies --unicode-placeholder, so the
  // image is anchored to real cells tmux owns instead of a classic placement
  // ghosting over neighbouring panes. Fall back to "chafa" (never "sixel":
  // tmux 3.7b handles it but kitty has no sixel decoder).
  "logo": {
    "type": "kitty-icat",
    "source": "~/.config/fastfetch/pngs/pochita.png",
    "width": 20,
    "height": 10,
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "key": "╭────────────╮",
      "type": "custom"
    },
    // {
    //     "key": "│ {#31} user    {#keys}│",
    //     "type": "title",
    //     "format": "{user-name}"
    // },
    {
      "key": "│ {#32}󰇅 hname   {#keys} │",
      "type": "title",
      "format": "{host-name}"
    },
    {
      "key": "│ {#33}󰅐 uptime  {#keys} │",
      "type": "uptime"
    },

    {
      "key": "│ {#35} kernel  {#keys} │",
      "type": "kernel"
    },
    {
      "key": "│ {#36}󰏖 packages {#keys}│",
      "type": "packages"
    },
    {
      "key": "│ {#36}󰇄 desktop {#keys} │",
      "type": "de"
    },
    {
      "key": "│ {#31} term    {#keys} │",
      "type": "terminal"
    },
    {
      "key": "│ {#32} shell   {#keys} │",
      "type": "shell"
    },
    {
      "key": "│ {#33}󰍛 cpu     {#keys} │",
      "type": "cpu",
      // drop the " @ 3.00 GHz" suffix: it pushes the line past ~77 cols and
      // wraps into the logo column in a floating kitty window
      "format": "{name} ({cores-logical})"
    },
    // {
    //   "key": "│ {#34}󰉉 disk    {#keys} │",
    //   "type": "disk",
    //   "folders": "/"
    // },
    {
      "key": "│ {#35} memory  {#keys} │",
      "type": "memory"
    },
    // {
    //   "key": "│ {#36}󰩟 network {#keys} │",
    //   "type": "localip",
    //   "format": "{ipv4} ({ifname})"
    // },
    {
      "key": "╰────────────╯",
      "type": "custom"
    }
  ]
}
