#!/usr/bin/env bash
# Stop the active wf-recorder cleanly (SIGINT) and report the saved file.
set -euo pipefail

PIDFILE="/tmp/wf-recording.pid"
PATHFILE="/tmp/wf-recording.path"

if [[ ! -f "$PIDFILE" ]] || ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
	notify-send -i dialog-error "Recorder" "No active recording"
	rm -f "$PIDFILE"
	exit 0
fi

pid=$(cat "$PIDFILE")
kill -INT "$pid" # SIGINT lets wf-recorder finalize the mp4 (moov atom)
for _ in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
rm -f "$PIDFILE"

file=$(cat "$PATHFILE" 2>/dev/null || true)
rm -f "$PATHFILE"
if [[ -n "$file" && -f "$file" && $(stat -c%s "$file") -gt 1024 ]]; then
	notify-send -i media-playback-stop "Recorder" "Saved: $(basename "$file")"
else
	notify-send -i dialog-error "Recorder" "Recording failed — no valid output"
fi
