#!/usr/bin/env bash
# Screen recorder — wf-recorder + Intel VAAPI (h264), CFR for smooth playback.
# Modes: full | region | audio | region-audio   (pick via qs: Super+R)
# Stop with stop-recording (Super+Shift+R).
set -euo pipefail

OUTDIR="$HOME/Videos/Recordings"
PIDFILE="/tmp/wf-recording.pid"
PATHFILE="/tmp/wf-recording.path"
DEVICE="/dev/dri/renderD128" # ponytail: hardcoded Intel render node; change if GPU differs
FPS=60
QP=18    # h264_vaapi constant quality: lower = better, 18 ≈ visually lossless
CODEC="h264_vaapi"

mkdir -p "$OUTDIR"

# Already recording? don't stack a second instance.
if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
	notify-send -i media-record "Recorder" "Already recording — Super+Shift+R to stop"
	exit 0
fi
rm -f "$PIDFILE"

mode="${1:-}"
if [[ -z "$mode" ]]; then
	notify-send -i dialog-error "Recorder" "Usage: wf-screenRE full|region|audio|region-audio"
	exit 1
fi

# Quality/perf args shared by all modes. -r forces constant framerate (smooth).
args=(-d "$DEVICE" -c "$CODEC" -r "$FPS" -p rc_mode=CQP -p qp="$QP")

focused_monitor() { hyprctl -j monitors | jq -r '.[] | select(.focused) | .name'; }
desktop_audio() { printf '%s.monitor' "$(pactl get-default-sink)"; } # capture what you hear

case "$mode" in
full) args+=(-o "$(focused_monitor)") ;;
region) args+=(-g "$(slurp)") ;;
audio) args+=(-o "$(focused_monitor)" -a"$(desktop_audio)") ;;
region-audio) args+=(-g "$(slurp)" -a"$(desktop_audio)") ;;
*)
	notify-send -i dialog-error "Recorder" "Unknown mode: $mode"
	exit 1
	;;
esac

file="$OUTDIR/rec-$(date +%Y%m%d-%H%M%S).mp4"
echo "$file" >"$PATHFILE"

wf-recorder "${args[@]}" -f "$file" &>"$OUTDIR/recording.log" &
echo $! >"$PIDFILE"

# Confirm it actually survived launch — VAAPI/codec errors die instantly.
sleep 0.5
if ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
	rm -f "$PIDFILE" "$PATHFILE"
	notify-send -i dialog-error "Recorder" "Failed: $(tail -n1 "$OUTDIR/recording.log")"
	exit 1
fi
notify-send -i media-record "Recorder" "Recording ($mode) started"
