{
  "name": "panel",
  "margin-top": 5,
  "margin-bottom": 5,
  "margin-left": 5,
  "margin-right": 0,
  "layer": "bottom",
  "position": "left",
  "height": 30,
  "width": 18,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,

  "modules-left": ["custom/padd", "clock"],
  "modules-center": ["custom/padd", "hyprland/workspaces", "custom/padd"],
  "modules-right": ["tray", "pulseaudio", "pulseaudio#microphone", "battery", "custom/padd"],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "١",
      "2": "٢",
      "3": "٣",
      "4": "٤",
      "5": "٥",
      "6": "٦",
      "7": "٧",
      "8": "٨",
      "9": "٩",
      "urgent": "⚠"
    },
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },

  "battery": {
    "rotate": 0,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": " {icon} ",
    "format-charging": "",
    "format-plugged": "",
    "format-alt": "{time} {icon}",
    "tooltip-format": "{capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "on-click-right": "~/.config/rofi/files/applets/bin/battery.sh"
  },

  "clock": {
    "format": "{:%H:%M 󰃭 %a %d}",
    "format-alt": "{:%H:%M  %b %Y}",
    "tooltip-format": "<tt><big>{calendar}</big></tt>",
    "rotate": 90,
    "spacing": 5
  },

  "tray": {
    "icon-size": 13,
    "spacing": 4
  },

  "pulseaudio": {
    "format": "󰕾",
    "format-muted": "󰝟",
    "on-click": "pavucontrol -t 3",
    "on-click-middle": "swayosd-client --output-volume mute-toggle",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower",
    "tooltip-format": "{icon} {desc} // {volume}%",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": ""
    }
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "on-click": "pavucontrol -t 4",
    "on-click-middle": "swayosd-client --input-volume mute-toggle",
    "on-scroll-up": "swayosd-client --input-volume lower",
    "on-scroll-down": "swayosd-client --input-volume raise",
    "tooltip-format": "{format_source} {source_desc} // {source_volume}%",
    "scroll-step": 5
  },

  "custom/padd": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  }
}
