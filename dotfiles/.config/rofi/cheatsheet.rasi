// Hyprland which-key cheatsheet — read-only, themed to match the rest of rofi.
configuration {
    show-icons: false;
}

@import "colors.rasi"

* {
    font:    "IosevkaTermNerdFont 11";
    bg:      #101010;
    fg:      #E8E8E8;
    accent:  #742849;
    dim:     #6E6E6E;
}

window {
    transparency:     "real";
    location:         center;
    width:            560px;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    0px;
    background-color: @bg;
    padding:          20px;
    cursor:           "default";
}

mainbox {
    children:         [ "message", "listview" ];
    spacing:          12px;
    background-color: transparent;
}

message {
    background-color: transparent;
    padding:          0px 0px 4px 0px;
    border:           0px 0px 1px 0px solid;
    border-color:     @dim;
}

textbox {
    background-color: transparent;
    text-color:       @accent;
    markup:           true;
    horizontal-align: 0.5;
}

inputbar { enabled: false; }
prompt   { enabled: false; }
entry    { enabled: false; }

listview {
    columns:          1;
    lines:            18;
    dynamic:          true;
    scrollbar:        false;
    cycle:            false;
    spacing:          2px;
    background-color: transparent;
}

element {
    padding:          2px 6px;
    border-radius:    0px;
    background-color: transparent;
    text-color:       @fg;
    cursor:           "default";
}

element selected {
    background-color: transparent;
    text-color:       @fg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    markup:           true;
}
