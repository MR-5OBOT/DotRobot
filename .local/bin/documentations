#!/usr/bin/env bash

# Initialize the topic variable
topic=""

# Fetch the list of all available topics from cht.sh
topic=$(curl -s cht.sh/:list | fzf --prompt="Select a topic: ")

# If no topic was selected, exit the script
if [[ -z "$topic" ]]; then
  echo "No topic selected. Exiting."
  exit 0
fi

# Fetch the list of sheets for the selected topic
sheet=$(curl -s "cht.sh/$topic/:list" | fzf --prompt="Select a sheet: ")

# If no sheet was selected, show the main topic documentation
if [[ -z "$sheet" ]]; then
  echo "Fetching documentation for $topic..."
  curl -s "cht.sh/$topic?style=rrt" | less -R
  exit 0
fi

# Fetch and display the selected sheet content
echo "Fetching documentation for $topic/$sheet..."
curl -s "cht.sh/$topic/$sheet?style=rrt" | less -R

