#!/bin/bash

# Switch to main branch
git checkout main

# Create a temporary directory
tmp_dir=$(mktemp -d)

# Copy contents of dist/ to the temporary directory
cp -r main/dist/* "$tmp_dir"

# Switch to gh-pages branch
git checkout gh-pages

# Remove existing dist/ directory (if exists)
rm -rf dist

# Move the copied contents to dist/ in gh-pages branch
mv "$tmp_dir"/* dist/

# Remove the temporary directory
rm -rf "$tmp_dir"

# Add dist/ to staging area
git add dist/

# Commit the changes
git commit -m "chore: update gh-pages"

# Push the changes
git push origin gh-pages

# Switch back to main branch
git checkout main
