#!/usr/bin/env bash

REPO_BASE_DIR="$HOME/repos"
URGENT_THRESHOLD=36000  # 10 hours in seconds
WARNING_THRESHOLD=14400 # 4 hours in seconds

for repo in "$REPO_BASE_DIR"/*; do
  if [ -d "$repo/.git" ]; then
    cd "$repo" || continue

    if [[ $(git status --porcelain) ]]; then
      # Get the timestamp of the last commit
      LAST_COMMIT=$(git log -1 --format=%ct 2>/dev/null || echo $(date +%s))
      CURRENT_TIME=$(date +%s)
      TIME_DIFF=$((CURRENT_TIME - LAST_COMMIT))

      if [ $TIME_DIFF -gt $URGENT_THRESHOLD ]; then
        notify-send -u critical "URGENT: Push your changes!" "Uncommitted changes in $repo for >10h"

      elif [ $TIME_DIFF -gt $WARNING_THRESHOLD ]; then
        notify-send "Remember to push" "Uncommitted changes in $repo for >4h"
      fi

    fi
  fi
done

