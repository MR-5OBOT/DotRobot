#!/usr/bin/env bash

# Get the current date and time for the filename (e.g., 2025-02-06_15-30-00)
timestamp=$(date +"%Y-%m-%d_%H-%M-%S")

# Show Rofi menu with two entries in 2-column list layout
selection=$(echo -e "Record Fullscreen\nRecord Region" | rofi -dmenu -l 2 -p "Select recording mode")

if [[ $selection == "Record Fullscreen" ]]; then
	# Record the entire screen with dynamic filename based on the timestamp
	wf-recorder -f ~/Downloads/Recording/output_$timestamp.mkv
elif [[ $selection == "Record Region" ]]; then
	# Let the user select the region and record it with dynamic filename
	region=$(slurp)
	wf-recorder -g "$region" -f ~/Downloads/Recording/output_$timestamp.mkv
else
	# If no valid selection, exit
	echo "No valid option selected."
	exit 1
fi

# Notify that recording has started
notify-send "Start Recording" "Recording started at $timestamp"
echo "Recording started: $timestamp"
